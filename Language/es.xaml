<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--
        ================= LANGUAGE: Spanish (es) =================
        Every x:Key here MUST match en.xaml exactly - LanguageManager
        looks entries up by key, so a missing key doesn't fail to build,
        it just silently shows nothing (or the key name) at runtime for
        that one string. Keeping this file's keys in the same order as
        en.xaml makes a missing/renamed entry easy to spot by eye.
    -->

    <!--  ============ MEMORIAL ============  -->
    <system:String x:Key="Str_Memorial_Name">En Memoria de TOXY, con Cariño</system:String>
    <system:String x:Key="Str_Memorial_Dates">[5 de julio de 2019] – [23 de junio de 2026]</system:String>
    <system:String x:Key="Str_Memorial_Message">Un día tendré alas, y estaremos juntos de nuevo.</system:String>

</ResourceDictionary>