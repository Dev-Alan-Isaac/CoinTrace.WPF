<Window
    x:Class="CoinTrace.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Smart Tools"
    Width="900"
    Height="550"
    MinWidth="360"
    MinHeight="420"
    Closing="Window_Closing"
    Icon="/Images/Graphicloads-Flat-Finance-Dollar.ico"
    SizeChanged="Window_SizeChanged"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized">


    <Window.Resources>

        <!--
            ============================================================
            NAV PILL — layered surface with a soft fade-in hover wash,
            a persistent tinted "active" wash independent of hover, and
            a gradient accent indicator that eases in/out instead of
            snapping. Column/margin/padding metrics are unchanged from
            the original so every one of the 30+ RadioButtons below still
            lines up pixel-for-pixel; only the decoration is new.
        -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Bd"
                            Margin="8,2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <Grid>
                                <!--  Fade-in hover wash — sits under everything else  -->
                                <Border
                                    x:Name="HoverOverlay"
                                    Background="{DynamicResource SidebarItemHoverBg}"
                                    CornerRadius="8"
                                    Opacity="0" />
                                <!--  Persistent tinted wash for the checked/active page, independent of hover  -->
                                <Border
                                    x:Name="ActiveWash"
                                    Background="{DynamicResource AccentColorSubtle}"
                                    CornerRadius="8"
                                    Opacity="0" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        x:Name="Indicator"
                                        Grid.Column="0"
                                        Width="3"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AccentGradient}"
                                        CornerRadius="2"
                                        Opacity="0" />
                                    <ContentPresenter
                                        Grid.Column="1"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverOverlay"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverOverlay"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!--
                                Persistent active-page state: subtle accent-tinted wash +
                                gradient accent bar + accent-colored label, independent of
                                hover, both easing in on select and out on deselect.
                            -->
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ActiveWash"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.15" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="Indicator"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ActiveWash"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.15" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="Indicator"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Style for the small section headers (DATA QUALITY, FILE MANAGEMENT, ...)  -->
        <Style x:Key="SidebarHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="18,20,0,6" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <!--
            Small standalone icon buttons that sit outside the scrollable
            nav list (theme toggle, contact, memorial) - plain Buttons, not
            part of the MainNav RadioButton group, so they never compete
            with or interrupt which tool is currently selected. Same
            fade-in-wash treatment as the nav pills, plus a gentle press
            (scale) response for tactile feedback.
        -->
        <Style x:Key="SidebarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <Grid>
                                <Border
                                    x:Name="HoverOverlay"
                                    Background="{DynamicResource SidebarItemHoverBg}"
                                    CornerRadius="8"
                                    Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverOverlay"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverOverlay"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            ================= SIDEBAR =================
            Collapsed (Visibility + zero column width) until a login
            succeeds - see MainWindow.xaml.cs ShowAuthScreen/CompleteLogin.
            The Effect renders outside the Border's own layout bounds and
            the parent Grid doesn't clip by default, so this soft shadow
            bleeds a few pixels into the content column - reads as a
            panel gently floating above the content instead of a flat
            block of color butted up against it.
        -->
        <Border
            x:Name="SidebarBorder"
            Grid.Column="0"
            Background="{DynamicResource SidebarBg}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="18"
                    Direction="0"
                    Opacity="0.18"
                    ShadowDepth="3"
                    Color="Black" />
            </Border.Effect>
            <DockPanel>

                <!--  App title / logo area  -->
                <Border
                    Padding="18,20,18,16"
                    BorderBrush="{DynamicResource SidebarBorder}"
                    BorderThickness="0,0,0,1"
                    DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Margin="-10,0,0,0"
                            Orientation="Horizontal">

                            <!--  Gradient brand badge - purely decorative, no code-behind reference  -->
                            <Border
                                Width="34"
                                Height="34"
                                Margin="0,0,10,0"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AccentGradient}"
                                CornerRadius="9">
                                <materialDesign:PackIcon
                                    Width="19"
                                    Height="19"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="HandCoin" />
                            </Border>

                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtAppTitle"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource SidebarText}"
                                    MouseLeftButtonDown="TxtAppTitle_MouseLeftButtonDown"
                                    Text="Coin Trace" />
                                <TextBlock
                                    x:Name="TxtAppSubtitle"
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource SidebarTextMuted}"
                                    Text="Finance Suite" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">

                            <Button
                                x:Name="BtnContactDeveloper"
                                Click="BtnContactDeveloper_Click"
                                Style="{StaticResource SidebarIconButtonStyle}"
                                ToolTip="Contact Developer">
                                <materialDesign:PackIcon
                                    Width="17"
                                    Height="17"
                                    Foreground="{DynamicResource SidebarText}"
                                    Kind="EmailOutline" />
                            </Button>

                            <Button
                                x:Name="BtnThemeToggle"
                                Margin="2,0,0,0"
                                Click="BtnThemeToggle_Click"
                                Style="{StaticResource SidebarIconButtonStyle}"
                                ToolTip="Switch between light and dark theme">
                                <materialDesign:PackIcon
                                    x:Name="IconThemeToggle"
                                    Width="18"
                                    Height="18"
                                    Foreground="{DynamicResource SidebarText}"
                                    Kind="WeatherNight" />
                            </Button>

                        </StackPanel>

                    </Grid>
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,0,0" KeyboardNavigation.DirectionalNavigation="Cycle">

                        <!--  BORROWERS SECTION  -->
                        <TextBlock
                            x:Name="HeaderBorrowers"
                            Style="{StaticResource SidebarHeaderStyle}"
                            Text="BORROWERS" />

                        <RadioButton
                            x:Name="BtnBorrowers"
                            Checked="BtnBorrowers_Click"
                            GroupName="MainNav"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            ToolTip="Borrowers">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Kind="AccountMultiple" />
                                <TextBlock
                                    x:Name="LblBorrowers"
                                    VerticalAlignment="Center"
                                    Text="Borrowers"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </RadioButton>

                        <!--  OPTIONS SECTION  -->
                        <TextBlock
                            x:Name="HeaderOptions"
                            Style="{StaticResource SidebarHeaderStyle}"
                            Text="OPTIONS" />

                        <RadioButton
                            x:Name="BtnSettings"
                            Checked="BtnSettings_Click"
                            GroupName="MainNav"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            ToolTip="Settings">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Kind="Cog" />
                                <TextBlock
                                    x:Name="LblSettings"
                                    VerticalAlignment="Center"
                                    Text="Settings"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!--  ================= CONTENT AREA =================  -->
        <Border Grid.Column="1" Background="{DynamicResource ContentBg}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    ================= BREADCRUMB =================
                    Collapsed until a login succeeds, same as the sidebar.
                -->
                <Border
                    x:Name="BreadcrumbBorder"
                    Grid.Row="0"
                    Padding="20,14"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="Smart Tools" />
                        <TextBlock
                            Margin="8,0"
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="›" />
                        <Border
                            Width="6"
                            Height="6"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentGradient}"
                            CornerRadius="3" />
                        <TextBlock
                            x:Name="TxtBreadcrumbActive"
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="Validate Data" />
                    </StackPanel>
                </Border>

                <!--
                    No ScrollViewer here on purpose: this Grid row now gives the
                    active view a bounded height equal to the window's content
                    area. Each view manages its own internal scrolling (its
                    options sidebar has its own ScrollViewer, and any DataGrid
                    scrolls internally via VerticalScrollBarVisibility="Auto").
                    Wrapping this in a ScrollViewer would hand every child an
                    effectively infinite available height, which is what let a
                    large DataGrid (e.g. 10,000+ rows) balloon the whole page
                    instead of scrolling within its own bounds.
                    
                    Also hosts the pre-login screens (CreateAccountView,
                    LoginView, ForgotPasswordView) before the sidebar/
                    breadcrumb are revealed - see MainWindow.xaml.cs.
                -->
                <ContentControl
                    x:Name="MainContentArea"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

            </Grid>

        </Border>

    </Grid>
</Window>
