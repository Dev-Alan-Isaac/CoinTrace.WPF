<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============================================================
        LIGHT THEME  —  "professional" pass
        ============================================================
        Every x:Key below is unchanged from the original file, so every
        DynamicResource binding in every View keeps working with zero
        edits elsewhere. What changed is the VALUES: a deeper, richer
        accent instead of a pastel sky-blue, cooler/more refined
        neutrals, a subtle top-to-bottom gradient on the sidebar instead
        of one flat fill, and two new elevation ("shadow") resources so
        cards can read as raised surfaces instead of flat rectangles
        with a hairline around them.
        
        New keys added at the bottom (AccentColorHover/Pressed/Subtle,
        AccentGradientStart/End, CardElevation, SidebarElevation) are
        additive only — nothing existing was removed or renamed.
    -->

    <!--  Page / content area background (behind cards)  -->
    <SolidColorBrush x:Key="ContentBg" Color="#F3F5F9" />

    <!--  Card / panel surfaces  -->
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#E2E6EF" />

    <!--  A slightly recessed row background used inside cards (list rows, etc.)  -->
    <SolidColorBrush x:Key="RowBg" Color="#F7F9FC" />

    <!--  Text  -->
    <SolidColorBrush x:Key="TextPrimary" Color="#161E2C" />
    <SolidColorBrush x:Key="TextSecondary" Color="#64748B" />

    <!--  Inputs (TextBox / ComboBox) that sit on a light card  -->
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorder" Color="#CBD5E1" />
    <SolidColorBrush x:Key="InputText" Color="#161E2C" />

    <!--
        Accent — deepened from the old #4C8DFF sky-blue to a richer,
        more saturated indigo-blue. Reads as a deliberate brand color
        instead of a default "flat UI" pastel; still close enough in
        hue that any spot in the app hardcoding the old hex directly
        (instead of {DynamicResource AccentColor}) won't clash badly,
        but grep for "#4C8DFF" and switch those to the resource so the
        whole app repaints consistently.
    -->
    <SolidColorBrush x:Key="AccentColor" Color="#3D6FE0" />

    <!--
        ============ SEMANTIC STATUS COLORS ============
        Unchanged from the original — these pastel/dark pill pairs
        already read cleanly and didn't need touching.
    -->
    <SolidColorBrush x:Key="StatusSuccessBg" Color="#DCFCE7" />
    <SolidColorBrush x:Key="StatusSuccessFg" Color="#15803D" />

    <SolidColorBrush x:Key="StatusInfoBg" Color="#DBEAFE" />
    <SolidColorBrush x:Key="StatusInfoFg" Color="#1D4ED8" />

    <SolidColorBrush x:Key="StatusWarningBg" Color="#FEF3C7" />
    <SolidColorBrush x:Key="StatusWarningFg" Color="#B45309" />

    <SolidColorBrush x:Key="StatusErrorBg" Color="#FEE2E2" />
    <SolidColorBrush x:Key="StatusErrorFg" Color="#B91C1C" />

    <!--
        ============ SIDEBAR (options panel present in every view) ============
        Was a flat #263342. A subtle vertical gradient (lighter at the
        top, deeper at the bottom) gives the same "always-dark branded
        panel" surface real depth instead of reading as one poster-paint
        rectangle — the single change that does the most to make the
        options rail feel like a designed surface rather than a filler
        block of color.
    -->
    <LinearGradientBrush x:Key="SidebarBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2B3A4F" />
        <GradientStop Offset="1" Color="#1E2A3B" />
    </LinearGradientBrush>

    <!--  Nested "step"/filter cards that sit ON the sidebar  -->
    <SolidColorBrush x:Key="SidebarCardBg" Color="#38475A" />

    <!--  Hover background for sidebar nav buttons (MainWindow)  -->
    <SolidColorBrush x:Key="SidebarItemHoverBg" Color="#435269" />

    <!--
        A further-recessed sub-panel inside a sidebar card (e.g. "Group
        Unknown Extensions" panel nested inside a step card)
    -->
    <SolidColorBrush x:Key="SidebarSubPanelBg" Color="#1B2530" />

    <!--  Text sitting directly on the (always-dark) sidebar  -->
    <SolidColorBrush x:Key="SidebarText" Color="#EDEFF4" />
    <SolidColorBrush x:Key="SidebarTextMuted" Color="#9BA8BC" />

    <!--
        Inputs that sit ON the sidebar — separate from InputBg/InputBorder
        above, which are for inputs sitting on the main (light) CardBg surface
    -->
    <SolidColorBrush x:Key="SidebarInputBg" Color="#1B2431" />
    <SolidColorBrush x:Key="SidebarInputBorder" Color="#46536B" />
    <SolidColorBrush x:Key="SidebarInputText" Color="#EDEFF4" />

    <!--
        Subtle hairline border for panels/modals that sit on the
        (always-dark) SidebarBg surface — e.g. the video-compare overlay.
        Same translucent-white value in both themes since that surface
        never changes color between Light/Dark.
    -->
    <SolidColorBrush x:Key="SidebarBorder" Color="#17FFFFFF" />

    <!--
        Hairline border for the video-compare player frames, which sit
        on a fixed black MediaElement background regardless of theme.
    -->
    <SolidColorBrush x:Key="PlayerFrameBorder" Color="#1FFFFFFF" />

    <!--
        ============ NEW: ACCENT STATE + GRADIENT TOKENS ============
        Additive only. Used by the ControlsPolish.xaml overrides for a
        gradient PrimaryButtonStyle and proper hover/pressed shading
        instead of the old "just drop the opacity" treatment.
    -->
    <SolidColorBrush x:Key="AccentColorHover" Color="#345FD1" />
    <SolidColorBrush x:Key="AccentColorPressed" Color="#2A4EB0" />
    <SolidColorBrush x:Key="AccentColorSubtle" Color="#E9EEFC" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#4C7EF2" />
        <GradientStop Offset="1" Color="#2C4FC7" />
    </LinearGradientBrush>

    <!--
        ============ NEW: ELEVATION ============
        A soft, cool-tinted (not pure black) shadow reads as "raised
        card" rather than "gray smudge" — this is what CardStyle /
        RoundedCardStyle / SidebarPanelStyle now apply via
        Effect="{DynamicResource CardElevation}" in ControlsPolish.xaml.
    -->
    <DropShadowEffect
        x:Key="CardElevation"
        BlurRadius="20"
        Direction="270"
        Opacity="0.10"
        ShadowDepth="3"
        Color="#1A202C" />

    <DropShadowEffect
        x:Key="ButtonElevation"
        BlurRadius="14"
        Direction="270"
        Opacity="0.22"
        ShadowDepth="2"
        Color="#2C4FC7" />

    <!--
        Raw Color (not a Brush) so it can be plugged into a per-button
        INLINE DropShadowEffect's Color property in ControlsPolish.xaml —
        those inline effects are deliberately not shared resources (each
        button gets its own instance) since their Opacity is animated on
        hover/press, and animating a single shared Freezable would make
        every button glow at once.
    -->
    <Color x:Key="ButtonHoverGlowColor">#2C4FC7</Color>

</ResourceDictionary>
