<UserControl
    x:Class="CoinTrace.WPF.Views.ContactDeveloperView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Background="{DynamicResource ContentBg}">

        <Border
            Width="480"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}"
            CornerRadius="10">

            <StackPanel>

                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Str_Contact_Title}" />

                <TextBlock
                    Margin="0,4,0,20"
                    Style="{StaticResource PageSubtitle}"
                    Text="{DynamicResource Str_Contact_Subtitle}" />

                <!--  PLACEHOLDER - update EmailAddress in the code-behind with the real address  -->
                <Button
                    x:Name="BtnContactEmail"
                    Height="50"
                    Margin="0,0,0,10"
                    Padding="10"
                    HorizontalContentAlignment="Left"
                    Background="{DynamicResource InputBg}"
                    BorderThickness="0"
                    Click="BtnContactEmail_Click"
                    Cursor="Hand"
                    ToolTip="{DynamicResource Str_Contact_EmailTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextPrimary}"
                            Kind="EmailOutline" />
                        <TextBlock
                            x:Name="TxtContactEmail"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="contactalanisaac@gmail.com" />
                    </StackPanel>
                </Button>

                <!--  PLACEHOLDER - update GitHubUrl in the code-behind with the real link  -->
                <Button
                    x:Name="BtnContactGitHub"
                    Height="50"
                    Padding="10"
                    HorizontalContentAlignment="Left"
                    Background="{DynamicResource InputBg}"
                    BorderThickness="0"
                    Click="BtnContactGitHub_Click"
                    Cursor="Hand"
                    ToolTip="{DynamicResource Str_Contact_GithubTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextPrimary}"
                            Kind="Github" />
                        <TextBlock
                            x:Name="TxtContactGitHub"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="github.com/Dev-Alan-Isaac" />
                    </StackPanel>
                </Button>

                <TextBlock
                    x:Name="TxtContactStatus"
                    Margin="0,10,0,0"
                    FontSize="11.5"
                    Foreground="{DynamicResource StatusErrorFg}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
