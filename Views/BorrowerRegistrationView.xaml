<UserControl
    x:Class="CoinTrace.WPF.Views.BorrowerRegistrationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:CoinTrace.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CoinTrace.WPF.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:CoinTrace.WPF.Models"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="640"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <!--
        Same page shell as ValidateFileView/SettingsView: an ElevatedCardStyle
        header (icon badge + PageTitle/PageSubtitle, then an action bar) over
        a CardStyle content card. "Add borrower" no longer drops a live row
        straight into the grid - it opens the same scrim+centered-card modal
        SettingsView uses for "Add Category"/"Add Pattern", and the borrower
        is only actually created (via BorrowerRepository) once "Add" is
        confirmed. Existing borrowers are still edited in place, cell by
        cell, directly in the grid.
    -->
    <UserControl.Resources>

        <ObjectDataProvider
            x:Key="BorrowerStatusValues"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:BorrowerStatus" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <converters:BorrowerStatusToBrushConverter x:Key="StatusToBrush" />
        <converters:BorrowerStatusToLabelConverter x:Key="StatusToLabel" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  Small round icon badge used for the grid's "On file" column (phone/email/address on file)  -->
        <Style x:Key="ContactBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource AccentColorSubtle}" />
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ================= HEADER =================  -->

        <Border
            Grid.Row="0"
            Margin="16,16,16,12"
            Padding="20,16"
            Style="{StaticResource ElevatedCardStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PageHeaderIconBadgeStyle}">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="AccountMultiple" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Borrowers" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Everyone you're currently tracking a loan or balance with. Click any cell in the grid to edit it - changes save automatically." />
                    </StackPanel>
                </Grid>

                <!--  ================= ACTION BAR: search + saved indicator + add =================  -->

                <Border
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    Padding="12,8"
                    Background="{DynamicResource ContentBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            TextChanged="SearchBox_TextChanged"
                            ToolTip="Search by name, phone, email or address" />

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <materialDesign:PackIcon
                                x:Name="SavedIcon"
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentColor}"
                                Kind="CheckCircle"
                                Opacity="0" />
                            <TextBlock
                                x:Name="SavedText"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondary}"
                                Opacity="0"
                                Text="Saved" />
                        </StackPanel>

                        <Button
                            x:Name="BtnAddBorrower"
                            Grid.Column="4"
                            Width="150"
                            Height="38"
                            VerticalAlignment="Center"
                            Click="BtnAddBorrower_Click"
                            Content="+ Add borrower"
                            Style="{StaticResource AccentPrimaryButtonStyle}"
                            ToolTip="Add a new borrower" />

                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!--  ================= CONTENT =================  -->

        <Grid Grid.Row="1" Margin="16,0,16,16">

            <Border Padding="14" Style="{StaticResource CardStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  ============ SECTION HEADING + COMPACT SUMMARY ============  -->

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionHeading}"
                            Text="All borrowers" />

                        <!--  Three small pills: total / active / needs attention. Hidden until there's at least one borrower.  -->
                        <StackPanel
                            x:Name="SummaryPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Visibility="Collapsed">

                            <Border
                                Margin="0,0,6,0"
                                Padding="8,4"
                                Background="{DynamicResource StatusInfoBg}"
                                CornerRadius="6">
                                <TextBlock
                                    x:Name="TxtSummaryTotal"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusInfoFg}"
                                    Text="0 total" />
                            </Border>

                            <Border
                                Margin="0,0,6,0"
                                Padding="8,4"
                                Background="{DynamicResource StatusSuccessBg}"
                                CornerRadius="6">
                                <TextBlock
                                    x:Name="TxtSummaryActive"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusSuccessFg}"
                                    Text="0 active" />
                            </Border>

                            <Border
                                Padding="8,4"
                                Background="{DynamicResource StatusErrorBg}"
                                CornerRadius="6">
                                <TextBlock
                                    x:Name="TxtSummaryAttention"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusErrorFg}"
                                    Text="0 need attention" />
                            </Border>

                        </StackPanel>
                    </Grid>

                    <!--  ============ GRID + EMPTY STATE ============  -->

                    <Grid Grid.Row="1">

                        <DataGrid
                            x:Name="BorrowersGrid"
                            AutoGenerateColumns="False"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            CanUserResizeRows="False"
                            HeadersVisibility="Column"
                            RowHeight="42"
                            SelectionMode="Single"
                            SelectionUnit="FullRow">
                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Width="1.4*"
                                    Binding="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                    Header="Full name" />

                                <DataGridTemplateColumn
                                    Width="120"
                                    Header="Status"
                                    SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="8,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                CornerRadius="10">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="{Binding Status, Converter={StaticResource StatusToLabel}}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox
                                                BorderThickness="0"
                                                ItemsSource="{Binding Source={StaticResource BorrowerStatusValues}}"
                                                SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn
                                    Width="1.1*"
                                    Binding="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                    Header="Phone" />

                                <DataGridTextColumn
                                    Width="1.3*"
                                    Binding="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                    Header="Email" />

                                <DataGridTextColumn
                                    Width="1.4*"
                                    Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                    Header="Address" />

                                <DataGridTextColumn
                                    Width="1.4*"
                                    Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                    Header="Notes" />

                                <!--  Read-only "what's on file" summary  -->
                                <DataGridTemplateColumn
                                    Width="90"
                                    Header="On file"
                                    IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <Border
                                                    Style="{StaticResource ContactBadgeStyle}"
                                                    ToolTip="Has a phone number on file"
                                                    Visibility="{Binding HasPhone, Converter={StaticResource BoolToVis}}">
                                                    <materialDesign:PackIcon
                                                        Width="12"
                                                        Height="12"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource AccentColor}"
                                                        Kind="Phone" />
                                                </Border>
                                                <Border
                                                    Style="{StaticResource ContactBadgeStyle}"
                                                    ToolTip="Has an email on file"
                                                    Visibility="{Binding HasEmail, Converter={StaticResource BoolToVis}}">
                                                    <materialDesign:PackIcon
                                                        Width="12"
                                                        Height="12"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource AccentColor}"
                                                        Kind="Email" />
                                                </Border>
                                                <Border
                                                    Style="{StaticResource ContactBadgeStyle}"
                                                    ToolTip="Has an address on file"
                                                    Visibility="{Binding HasAddress, Converter={StaticResource BoolToVis}}">
                                                    <materialDesign:PackIcon
                                                        Width="12"
                                                        Height="12"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource AccentColor}"
                                                        Kind="MapMarker" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--  Row action: delete, with confirmation in code-behind  -->
                                <DataGridTemplateColumn
                                    Width="48"
                                    CanUserResize="False"
                                    Header=""
                                    IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button
                                                Click="DeleteRowButton_Click"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Delete borrower">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Kind="TrashCanOutline" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <Border
                            x:Name="EmptyStatePanel"
                            Padding="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource RoundedCardStyle}"
                            Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon
                                    Width="40"
                                    Height="40"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Kind="AccountMultipleOutline" />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource PageSubtitle}"
                                    Text="No borrowers yet - add one to get started"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                    </Grid>

                </Grid>
            </Border>

        </Grid>

        <!--  ================= ADD BORROWER OVERLAY =================  -->
        <!--
            Same in-app modal pattern as SettingsView's "Add Category"/"Add
            Pattern" overlays: a click-to-dismiss scrim behind a centered,
            drop-shadowed card, both embedded in this same UserControl (not
            a separate Window) and spanning both grid rows via
            Grid.RowSpan="2" so they sit above the header too. The borrower
            itself is only created - via BorrowerRepository.AddNew(), the
            same call the grid used before - once "Add borrower" is pressed
            here; closing the modal any other way discards whatever was
            typed.
        -->

        <Border
            x:Name="AddBorrowerScrim"
            Grid.RowSpan="2"
            Background="#B3000000"
            MouseDown="AddBorrowerScrim_MouseDown"
            Visibility="Collapsed" />

        <Border
            x:Name="AddBorrowerCard"
            Grid.RowSpan="2"
            Width="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource SidebarBg}"
            BorderBrush="{DynamicResource SidebarBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="36"
                    Opacity="0.45"
                    ShadowDepth="10"
                    Color="Black" />
            </Border.Effect>

            <StackPanel Margin="20">

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{DynamicResource SidebarText}"
                            Text="Add borrower" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11.5"
                            Foreground="{DynamicResource SidebarTextMuted}"
                            Text="Only the name is required - fill in the rest now or edit it later in the grid."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Width="26"
                        Height="26"
                        VerticalAlignment="Top"
                        Click="BtnCloseAddBorrower_Click"
                        Content="✕"
                        Foreground="{DynamicResource SidebarText}"
                        Style="{StaticResource NeutralIconButtonStyle}"
                        ToolTip="Close" />

                </Grid>

                <TextBlock Style="{StaticResource FieldLabel}" Text="FULL NAME" />
                <TextBox x:Name="TxtModalFullName" TextChanged="TxtModalFullName_TextChanged" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="STATUS" />
                        <ComboBox x:Name="CmbModalStatus" ItemsSource="{Binding Source={StaticResource BorrowerStatusValues}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="PHONE" />
                        <TextBox x:Name="TxtModalPhone" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Margin="0,14,0,0"
                    Style="{StaticResource FieldLabel}"
                    Text="EMAIL" />
                <TextBox x:Name="TxtModalEmail" />

                <TextBlock
                    Margin="0,14,0,0"
                    Style="{StaticResource FieldLabel}"
                    Text="ADDRESS" />
                <TextBox x:Name="TxtModalAddress" />

                <TextBlock
                    Margin="0,14,0,0"
                    Style="{StaticResource FieldLabel}"
                    Text="NOTES" />
                <TextBox
                    x:Name="TxtModalNotes"
                    Height="60"
                    VerticalContentAlignment="Top"
                    AcceptsReturn="True"
                    TextWrapping="Wrap" />

                <StackPanel
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="90"
                        Margin="0,0,8,0"
                        Click="BtnCloseAddBorrower_Click"
                        Content="Cancel" />
                    <Button
                        x:Name="BtnConfirmAddBorrower"
                        Width="130"
                        Click="BtnConfirmAddBorrower_Click"
                        Content="Add borrower"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>
</UserControl>
