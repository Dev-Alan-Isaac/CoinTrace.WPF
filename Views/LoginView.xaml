<UserControl
    x:Class="CoinTrace.WPF.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <Style x:Key="FieldTextBoxStyle" TargetType="Control">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{DynamicResource ContentBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style BasedOn="{StaticResource FieldTextBoxStyle}" TargetType="TextBox" />
        <Style BasedOn="{StaticResource FieldTextBoxStyle}" TargetType="PasswordBox" />

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--  Fills MainContentArea; the card centers itself within it  -->
    <Grid Background="{DynamicResource ContentBg}">
        <Border
            Width="380"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="18"
                    Direction="270"
                    Opacity="0.15"
                    ShadowDepth="3"
                    Color="Black" />
            </Border.Effect>

            <StackPanel>
                <Border
                    Width="44"
                    Height="44"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource AccentGradient}"
                    CornerRadius="12">
                    <materialDesign:PackIcon
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Kind="HandCoin" />
                </Border>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="Welcome back" />
                <TextBlock
                    Margin="0,2,0,20"
                    HorizontalAlignment="Center"
                    FontSize="12.5"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="Sign in to Coin Trace" />

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Username" />
                <TextBox x:Name="UsernameBox" Margin="0,0,0,14" />

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Password" />
                <PasswordBox x:Name="PasswordBox" />

                <TextBlock
                    x:Name="ErrorText"
                    Margin="0,12,0,0"
                    FontSize="12"
                    Foreground="#E5484D"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <TextBlock Margin="0,14,0,0">
                    <Hyperlink
                        x:Name="ForgotPasswordLink"
                        Click="ForgotPasswordLink_Click"
                        Foreground="{DynamicResource AccentColor}">
                        Forgot password?
                    </Hyperlink>
                </TextBlock>

                <StackPanel
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="ExitButton"
                        Width="90"
                        Margin="0,0,8,0"
                        Click="ExitButton_Click"
                        Content="Exit"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <Button
                        x:Name="LoginButton"
                        Width="100"
                        Click="LoginButton_Click"
                        Content="Sign in"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
