<Window x:Class="Smart_Tools.WPF.Views.ForgotPasswordView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset password" Height="420" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="24">

        <!-- Step 1: answer the secret question -->
        <StackPanel x:Name="QuestionStep">
            <TextBlock x:Name="SecretQuestionText" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBox x:Name="AnswerBox" Padding="6" Margin="0,8,0,0"/>

            <TextBlock x:Name="QuestionErrorText" Foreground="Red" TextWrapping="Wrap"
                       Margin="0,12,0,0" Visibility="Collapsed"/>

            <Button x:Name="VerifyAnswerButton" Content="Verify" Padding="6" Margin="0,20,0,0"
                    IsDefault="True" Click="VerifyAnswerButton_Click"/>
        </StackPanel>

        <!-- Step 2: set a new password (hidden until the answer checks out) -->
        <StackPanel x:Name="NewPasswordStep" Visibility="Collapsed">
            <TextBlock Text="New password" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewPasswordBox" Padding="6"/>

            <TextBlock Text="Confirm new password" Margin="0,14,0,4"/>
            <PasswordBox x:Name="ConfirmNewPasswordBox" Padding="6"/>

            <TextBlock x:Name="PasswordErrorText" Foreground="Red" TextWrapping="Wrap"
                       Margin="0,12,0,0" Visibility="Collapsed"/>

            <Button x:Name="SavePasswordButton" Content="Save new password" Padding="6" Margin="0,20,0,0"
                    IsDefault="True" Click="SavePasswordButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
