<UserControl
    x:Class="CoinTrace.WPF.Views.ForgotPasswordView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <Style x:Key="FieldTextBoxStyle" TargetType="Control">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{DynamicResource ContentBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style BasedOn="{StaticResource FieldTextBoxStyle}" TargetType="TextBox" />
        <Style BasedOn="{StaticResource FieldTextBoxStyle}" TargetType="PasswordBox" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Border
            Width="380"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="18"
                    Direction="270"
                    Opacity="0.15"
                    ShadowDepth="3"
                    Color="Black" />
            </Border.Effect>

            <Grid>

                <!--  Step 1: answer the secret question  -->
                <StackPanel x:Name="QuestionStep">
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="Reset your password" />

                    <TextBlock
                        x:Name="SecretQuestionText"
                        Margin="0,0,0,12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        TextWrapping="Wrap" />

                    <TextBox x:Name="AnswerBox" />

                    <TextBlock
                        x:Name="QuestionErrorText"
                        Margin="0,12,0,0"
                        FontSize="12"
                        Foreground="#E5484D"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="VerifyAnswerButton"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Stretch"
                        Click="VerifyAnswerButton_Click"
                        Content="Verify"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" />

                    <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center">
                        <Hyperlink
                            x:Name="BackToLoginLink"
                            Click="BackToLoginLink_Click"
                            Foreground="{DynamicResource AccentColor}">
                            Back to sign in
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!--  Step 2: set a new password (hidden until the answer checks out)  -->
                <StackPanel x:Name="NewPasswordStep" Visibility="Collapsed">
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="Set a new password" />

                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="New password" />
                    <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,14" />

                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="Confirm new password" />
                    <PasswordBox x:Name="ConfirmNewPasswordBox" />

                    <TextBlock
                        x:Name="PasswordErrorText"
                        Margin="0,12,0,0"
                        FontSize="12"
                        Foreground="#E5484D"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="SavePasswordButton"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Stretch"
                        Click="SavePasswordButton_Click"
                        Content="Save new password"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
