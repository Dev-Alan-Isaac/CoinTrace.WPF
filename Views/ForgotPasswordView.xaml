<Window
    x:Class="CoinTrace.WPF.Views.ForgotPasswordView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Reset password"
    Width="380"
    Height="440"
    Background="{DynamicResource ContentBg}"
    Icon="/Images/Graphicloads-Flat-Finance-Dollar.ico"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">
    <Border
        Margin="20"
        Padding="24"
        Background="{DynamicResource CardBg}"
        BorderBrush="{DynamicResource CardBorder}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="18"
                Direction="270"
                Opacity="0.15"
                ShadowDepth="3"
                Color="Black" />
        </Border.Effect>

        <Grid>

            <!--  Step 1: answer the secret question  -->
            <StackPanel x:Name="QuestionStep">
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="Reset your password" />

                <TextBlock
                    x:Name="SecretQuestionText"
                    Margin="0,0,0,12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    TextWrapping="Wrap" />

                <TextBox
                    x:Name="AnswerBox"
                    materialDesign:HintAssist.Hint="Your answer"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <TextBlock
                    x:Name="QuestionErrorText"
                    Margin="0,12,0,0"
                    FontSize="12"
                    Foreground="#E5484D"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <Button
                    x:Name="VerifyAnswerButton"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Stretch"
                    Click="VerifyAnswerButton_Click"
                    Content="Verify"
                    IsDefault="True"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>

            <!--  Step 2: set a new password (hidden until the answer checks out)  -->
            <StackPanel x:Name="NewPasswordStep" Visibility="Collapsed">
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="Set a new password" />

                <PasswordBox
                    x:Name="NewPasswordBox"
                    Margin="0,0,0,14"
                    materialDesign:HintAssist.Hint="New password"
                    Style="{StaticResource MaterialDesignOutlinedPasswordBox}" />

                <PasswordBox
                    x:Name="ConfirmNewPasswordBox"
                    materialDesign:HintAssist.Hint="Confirm new password"
                    Style="{StaticResource MaterialDesignOutlinedPasswordBox}" />

                <TextBlock
                    x:Name="PasswordErrorText"
                    Margin="0,12,0,0"
                    FontSize="12"
                    Foreground="#E5484D"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <Button
                    x:Name="SavePasswordButton"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Stretch"
                    Click="SavePasswordButton_Click"
                    Content="Save new password"
                    IsDefault="True"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
