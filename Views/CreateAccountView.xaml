<UserControl
    x:Class="CoinTrace.WPF.Views.CreateAccountView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <Style x:Key="FieldTextBoxStyle" TargetType="Control">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{DynamicResource ContentBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style BasedOn="{StaticResource FieldTextBoxStyle}" TargetType="TextBox" />
        <Style BasedOn="{StaticResource FieldTextBoxStyle}" TargetType="PasswordBox" />
        <Style BasedOn="{StaticResource FieldTextBoxStyle}" TargetType="ComboBox" />

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Border
            Width="400"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="18"
                    Direction="270"
                    Opacity="0.15"
                    ShadowDepth="3"
                    Color="Black" />
            </Border.Effect>

            <StackPanel>
                <Border
                    Width="44"
                    Height="44"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource AccentGradient}"
                    CornerRadius="12">
                    <materialDesign:PackIcon
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Kind="HandCoin" />
                </Border>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="Welcome to Coin Trace" />
                <TextBlock
                    Margin="0,2,0,20"
                    HorizontalAlignment="Center"
                    FontSize="12.5"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="Create a local account to protect your data"
                    TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Username" />
                <TextBox x:Name="UsernameBox" Margin="0,0,0,14" />

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Password" />
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,14" />

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Confirm password" />
                <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,14" />

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Secret question" />
                <ComboBox
                    x:Name="SecretQuestionCombo"
                    Margin="0,0,0,14"
                    IsEditable="True">
                    <ComboBoxItem Content="What was your first pet's name?" />
                    <ComboBoxItem Content="What city were you born in?" />
                    <ComboBoxItem Content="What was your childhood nickname?" />
                    <ComboBoxItem Content="What is your mother's maiden name?" />
                </ComboBox>

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Answer" />
                <TextBox x:Name="SecretAnswerBox" />
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="Used to reset your password if you forget it. Not case-sensitive."
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="ErrorText"
                    Margin="0,14,0,0"
                    FontSize="12"
                    Foreground="#E5484D"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <Button
                    x:Name="CreateButton"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Stretch"
                    Click="CreateButton_Click"
                    Content="Create account"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
