<Window x:Class="Smart_Tools.WPF.Views.CreateAccountView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create your account" Height="520" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Welcome to Coin Trace" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Text="Create a local account to protect your data." Foreground="Gray"
                   TextWrapping="Wrap" Margin="0,0,0,16"/>

        <TextBlock Text="Username" Margin="0,0,0,4"/>
        <TextBox x:Name="UsernameBox" Padding="6"/>

        <TextBlock Text="Password" Margin="0,14,0,4"/>
        <PasswordBox x:Name="PasswordBox" Padding="6"/>

        <TextBlock Text="Confirm password" Margin="0,14,0,4"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Padding="6"/>

        <TextBlock Text="Secret question" Margin="0,14,0,4"/>
        <ComboBox x:Name="SecretQuestionCombo" Padding="6" IsEditable="True">
            <ComboBoxItem Content="What was your first pet's name?"/>
            <ComboBoxItem Content="What city were you born in?"/>
            <ComboBoxItem Content="What was your childhood nickname?"/>
            <ComboBoxItem Content="What is your mother's maiden name?"/>
        </ComboBox>

        <TextBlock Text="Answer" Margin="0,14,0,4"/>
        <TextBox x:Name="SecretAnswerBox" Padding="6"/>
        <TextBlock Text="Used to reset your password if you forget it. Not case-sensitive."
                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"
                   Margin="0,14,0,0" Visibility="Collapsed"/>

        <Button x:Name="CreateButton" Content="Create account" Padding="6" Margin="0,20,0,0"
                IsDefault="True" Click="CreateButton_Click"/>
    </StackPanel>
</Window>
