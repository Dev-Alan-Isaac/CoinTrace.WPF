<Window
    x:Class="CoinTrace.WPF.Views.CreateAccountView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Create your account"
    Width="400"
    Height="640"
    Background="{DynamicResource ContentBg}"
    Icon="/Images/Graphicloads-Flat-Finance-Dollar.ico"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">
    <Border
        Margin="20"
        Padding="24"
        Background="{DynamicResource CardBg}"
        BorderBrush="{DynamicResource CardBorder}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="18"
                Direction="270"
                Opacity="0.15"
                ShadowDepth="3"
                Color="Black" />
        </Border.Effect>

        <StackPanel>
            <Border
                Width="44"
                Height="44"
                Margin="0,0,0,12"
                HorizontalAlignment="Center"
                Background="{DynamicResource AccentGradient}"
                CornerRadius="12">
                <materialDesign:PackIcon
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Kind="HandCoin" />
            </Border>

            <TextBlock
                HorizontalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Foreground="{DynamicResource TextPrimary}"
                Text="Welcome to Coin Trace" />
            <TextBlock
                Margin="0,2,0,20"
                HorizontalAlignment="Center"
                FontSize="12.5"
                Foreground="{DynamicResource TextSecondary}"
                Text="Create a local account to protect your data"
                TextWrapping="Wrap" />

            <TextBox
                x:Name="UsernameBox"
                Margin="0,0,0,14"
                materialDesign:HintAssist.Hint="Username"
                Style="{StaticResource MaterialDesignOutlinedTextBox}" />

            <PasswordBox
                x:Name="PasswordBox"
                Margin="0,0,0,14"
                materialDesign:HintAssist.Hint="Password"
                Style="{StaticResource MaterialDesignOutlinedPasswordBox}" />

            <PasswordBox
                x:Name="ConfirmPasswordBox"
                Margin="0,0,0,14"
                materialDesign:HintAssist.Hint="Confirm password"
                Style="{StaticResource MaterialDesignOutlinedPasswordBox}" />

            <ComboBox
                x:Name="SecretQuestionCombo"
                Margin="0,0,0,14"
                materialDesign:HintAssist.Hint="Secret question"
                IsEditable="True"
                Style="{StaticResource MaterialDesignOutlinedComboBox}">
                <ComboBoxItem Content="What was your first pet's name?" />
                <ComboBoxItem Content="What city were you born in?" />
                <ComboBoxItem Content="What was your childhood nickname?" />
                <ComboBoxItem Content="What is your mother's maiden name?" />
            </ComboBox>

            <TextBox
                x:Name="SecretAnswerBox"
                materialDesign:HintAssist.Hint="Answer"
                Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            <TextBlock
                Margin="0,6,0,0"
                FontSize="11"
                Foreground="{DynamicResource TextSecondary}"
                Text="Used to reset your password if you forget it. Not case-sensitive."
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="ErrorText"
                Margin="0,14,0,0"
                FontSize="12"
                Foreground="#E5484D"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <Button
                x:Name="CreateButton"
                Margin="0,20,0,0"
                HorizontalAlignment="Stretch"
                Click="CreateButton_Click"
                Content="Create account"
                IsDefault="True"
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>
    </Border>
</Window>
